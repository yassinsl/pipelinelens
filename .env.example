# PipelineLens environment configuration (example).
# Copy this file to .env and fill in real values. Never commit your real .env.
# Values are read from real environment variables first, then from .env.
# The app and GET /health start without any of these; POST /analyze returns a
# 503 configuration error until LLM_API_KEY and LLM_MODEL are set.

# --- LLM provider (OpenAI-compatible API) ---
# API key for the provider. Required to enable POST /analyze. Keep it secret.
# LLM_API_KEY=sk-your-key-here
# Model identifier to use for analysis. Required to enable POST /analyze.
# LLM_MODEL=gpt-4o-mini
# Optional base URL for an OpenAI-compatible endpoint. Defaults to the OpenAI API.
# Use this to point at a compatible gateway or self-hosted server.
# LLM_BASE_URL=https://api.openai.com/v1
# Legacy alias for LLM_BASE_URL (still accepted; LLM_BASE_URL wins if both are set).
# LLM_API_BASE_URL=
# Optional structured-output mode: "json_schema" (default, recommended) or
# "json_object". json_schema asks the provider to enforce our response schema.
# LLM_RESPONSE_FORMAT=json_schema

# --- Local server (optional) ---
# HOST=127.0.0.1
# PORT=8000

